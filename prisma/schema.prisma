generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Hanya definisikan model PinnedSong milik Prisma
model PinnedSong {
  id        String   @id
  title     String
  artist    String
  thumbnail String
  duration  String
  createdAt DateTime @default(now())
}